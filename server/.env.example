# ---- Môi trường ----
NODE_ENV=development
PORT=4000

# MongoDB local (MongoDB Server) hoặc chuỗi kết nối MongoDB Atlas.
# MongoDB Compass chỉ là công cụ xem dữ liệu, dùng cùng chuỗi kết nối này.
MONGODB_URI=mongodb://127.0.0.1:27017/dtst
# Database riêng cho kiểm thử tự động (sẽ bị xóa sạch khi chạy test)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/dtst_test

# Chuỗi bí mật ngẫu nhiên >= 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Danh sách origin frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173

# URL công khai của frontend, dùng để tạo nội dung mã QR: {PUBLIC_APP_URL}/qr/{code}
PUBLIC_APP_URL=http://localhost:5173

# Cookie: "lax" khi frontend và API cùng site (khuyến nghị); "none" khi khác domain (bắt buộc HTTPS)
COOKIE_SAMESITE=lax
# Mặc định true khi NODE_ENV=production
# COOKIE_SECURE=true

# Số proxy đứng trước server (Render/Railway/Nginx thường là 1). 0 nếu chạy trực tiếp.
TRUST_PROXY=0

# Bật/tắt rate limit (luôn bật trong production)
RATE_LIMIT_ENABLED=true

# Đường dẫn tới thư mục build frontend để server phục vụ cùng origin (tùy chọn)
# SERVE_CLIENT_DIR=../client/dist

# ---- Tài khoản admin ban đầu (chỉ dùng cho script seed) ----
# Không commit mật khẩu thật. Mật khẩu tối thiểu 10 ký tự.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị viên
